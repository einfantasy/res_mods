# Every colour pref is a packed 0xAARRGGBB `color` setting, read straight off its component.

# The default a `color` setting is compared against to decide whether a directional line needs
# recolouring at all -- 0xFFCCCCCC, the packed form of the old palette's 'MARKERS' entry.  Compared
# explicitly rather than by sign or by index: packed values sit above 2^31.
(def constant TMap_DIRECTION_DEFAULT_COLOR 4291611852)

# shipType -> the schema's per-class toggle leaf.  NOT composable by toUpper(): the CMS emits
# `showIn.aircarrier` all-lower, so no case transform of 'AirCarrier' names it.
# A shipType absent here (Auxiliary, or an empty read before the avatar lands) yields '', which the
# call sites turn into "no key" -> no component -> the literal `true` fallback, exactly what the old
# TT_GET_NULLABLE_PREF_BOOL default did.
(def constant TMap_ENABLE_IN_CLASS_KEYS {
	AirCarrier	: 'showIn.aircarrier',
	Battleship	: 'showIn.battleship',
	Cruiser		: 'showIn.cruiser',
	Destroyer	: 'showIn.destroyer',
	Submarine	: 'showIn.submarine',
})

# Ally consumable-range key prefixes, by the consumable type the monitor reports.  The schema spells
# these `rangeCircle.<type>.ally` now, so a composed string would work -- kept a table because a
