
# Unknown control -> '' -> TT_SettingRowElement renders no widget (title still shows).
(def constant TT_CONFIG_RENDERERS {
	toggle		: 'TT_SwitchOptionElement',
	slider		: 'TT_SliderOptionElement',
	dropdown	: 'TT_DropdownOptionElement',
	'number'	: 'TT_NumericInputOptionElement',
	text		: 'TT_TextOptionElement',
	color		: 'TT_ColorOptionElement',
	button		: 'TT_ButtonOptionElement',
	position	: 'TT_PositionOptionElement',
})

# Native settings (backend:minimapOption): bind CC.minimapOption, write direct.action
# 'battle.saveMinimapOption'; never in the custom store.
(def constant TT_MINIMAP_RENDERERS {
	toggle		: 'TT_MinimapSwitchOptionElement',
	slider		: 'TT_MinimapSliderOptionElement',
	dropdown	: 'TT_MinimapDropdownOptionElement',
})


# Back-compat with the TT_Select dropdown infra; only the default text path applies here.
(def constant TT_DROPWDOWN_RENDERERS {
	DEFAULT: {
		DROPDOWN	: 'TT_SelectList',
		ITEM		: 'TT_SelectOption',
		CHOSEN_ITEM	: 'TT_SelectChosen',
	},
})
