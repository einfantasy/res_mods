(def constant ADDITIONAL_OPTIONS_INSTALLED true)


(def constant ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS {
	ADDITIONAL_RESOURCES: "ADDITIONAL_RESOURCES_INSTALLED",
	CAROUSEL: "CAROUSEL_INSTALLED",
	HIDE_RARITY: "HIDE_RARITY_INSTALLED",
	NAVI_BUTTONS: "NAVI_BUTTONS_INSTALLED",
	ORIGIN_FLAGS: "ORIGIN_FLAGS_INSTALLED",
	ORIGIN_SHIPS: "ORIGIN_SHIPS_INSTALLED",
	SERVER_POPULATION: "SERVER_POPULATION_INSTALLED",
	SHIP_NAMES: "SHIP_NAMES_INSTALLED"
})


(def macro ON_GET_ADDITIONAL_OPTION_COMPONENTS_FROM_CONSTANT()
	(var additionalResourcesAvailable:bool = "ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS['CAROUSEL']")
	(var carouselAvailable:bool = "ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS['CAROUSEL']")
	(var hideRarityAvailable:bool = "ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS['HIDE_RARITY']")
	(var naviButtonsAvailable:bool = "ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS['NAVI_BUTTONS']")
	(var originFlagsAvailable:bool = "ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS['ORIGIN_FLAGS']")
	(var originShipsAvailable:bool = "ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS['ORIGIN_SHIPS']")
	(var serverPopulationAvailable:bool = "ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS['SERVER_POPULATION']")
	(var shipNamesAvailable:bool = "ON_INSTALLED_ADDITIONAL_OPTION_COMPONENTS['SHIP_NAMES']")
)


(def constant ROW_TYPE {
