<ui>
<block className="ON_AccountResourcesWidget"><bind name="collectionDH" value="CC.battleType; 'selectedBattleTypes'; 'selected'"/><bind name="watch" value="'selectedBattleTypeGPID'; selectedBattleTypes[0].battleType.battleTypeGameParamId"/><bind name="collectionDH" value="CC.eventHubPhase; 'eventHubPhaseCollection'"/><bind name="watch" value="'currentPhaseEventID'; eventHubPhaseCollection[0].eventHubPhase.battleTypeGameParamId"/><bind name="firstEntityDH" value="'eventHubEntity'; CC.eventHubSeason"/><bind name="watchDH" value="'hasOwnSpace'; ['eventHubEntity.eventHubSeason.evChanged']; eventHubEntity.eventHubSeason.hasOwnSpace"/><bind name="watch" value="'isInEventHub'; hasOwnSpace &amp;&amp; isIn(selectedBattleTypes[0].eventBattleState.name, SC.Ui_common.EVENTS.EVENT_HUB_OPERATIONS)"/><bind name="primaryEntityDH" value="'eventHubFeatureEntity'; CC.accountFeature; SC.Common.ACCOUNT_FEATURE.BIT_MASKS[31]"/><bind name="watchDH" value="'eventHubFeatureState'; ['eventHubFeatureEntity.accountFeature.evStateChanged']; eventHubFeatureEntity.accountFeature.state"/><bind name="watch" value="'isEventHubUnlocked'; eventHubFeatureState != 'locked'"/><bind name="watch" value="'isEventModeEnabled'; hasOwnSpace &amp;&amp; (selectedBattleTypeGPID == currentPhaseEventID || (isInEventHub &amp;&amp; !isEventHubUnlocked))"/><bind name="firstEntityDH" value="'resourceEntity'; CC.accountResource"/><bind name="watchDH" value="'isSyncedWithWallet'; ['resourceEntity.accountResource.evChangedIsSyncedWithWallet']; resourceEntity.accountResource.isSyncedWithWallet"/><bind name="watchDH" value="'walletAvailable'; ['resourceEntity.accountResource.evChangedWalletStatus']; resourceEntity.accountResource.walletStatus"/><bind name="watch" value="'showWGWalletWarning'; isSyncedWithWallet == false || walletAvailable == false"/><bind name="file" value="'portInterfaceUrlsInstalled'; '../../gui_urls.xml'"/><bind name="stageSize"/><block>
				<style>
					<marginTop value="-4px"/>
					<flow value="horizontal"/>
				</style>
				<block>
					<style>
						<width value="1280:10,1920:18aw"/>
					</style>
				</block>
				<block>
